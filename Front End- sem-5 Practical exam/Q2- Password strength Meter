<!DOCTYPE html>
<html>
<head>
<title>Class Result Sheet</title>
<style>
body {
    font-family: Arial;
    background: #f2f2f2;
    padding: 30px;
}
.container {
    background: white;
    padding: 25px;
    width: 85AA%;
    margin: auto;
    text-align: center;
    border-radius: 10px;
}
button {
    padding: 10px 20px;
    background: #39465a;
    color: white;
    border: none;
    cursor: pointer;
}
table {
    width: 100%;
    margin-top: 20px;
    border-collapse: collapse;
}
th, td {
    padding: 12px;
    border: 1px solid #ddd;
}
th {
    background: #e5eaf0;
}
.fail {
    background: #ffcccc;
    color: red;
}
#summary {
    margin-top: 20px;
    text-align: left;
}
</style>
</head>

<body>
<div class="container">
<h2>Class Result Sheet</h2>

<button onclick="generateResults()">
Generate Results
</button>

<table>
<thead>
<tr>
<th>Name</th>
<th>Total (300)</th>
<th>Percentage</th>
<th>Grade</th>
<th>Result</th>
</tr>
</thead>
<tbody id="output"></tbody>
</table>

<div id="summary"></div>
</div>

<script>
let students = [
{name:"Anna", maths:85, science:85, english:85},
{name:"Rahul", maths:60, science:65, english:62},
{name:"Meena", maths:95, science:94, english:94},
{name:"Karthik", maths:50, science:32, english:55},
{name:"Divya", maths:70, science:70, english:70}
];

function getGrade(percent) {
    if(percent >= 90) return "A+";
    if(percent >= 75) return "A";
    if(percent >= 60) return "B";
    if(percent >= 50) return "C";
    return "D";
}

function generateResults() {
    let output = document.getElementById("output");
    output.innerHTML = "";

    let totalPercent = 0;
    let passed = 0;
    let topper = students[0];

    students.forEach(s => {
        let total = s.maths + s.science + s.english;
        let percent = total / 3;
        let grade = getGrade(percent);

        let result =
        (s.maths >= 35 && s.science >= 35 &&
        s.english >= 35) ? "Pass" : "Fail";

        if(result == "Pass") passed++;

        totalPercent += percent;

        if(percent > (topper.maths +
        topper.science + topper.english) / 3) {
            topper = s;
        }

        let row = output.insertRow();
        if(result == "Fail") {
            row.className = "fail";
        }

        row.insertCell(0).innerText = s.name;
        row.insertCell(1).innerText = total;
        row.insertCell(2).innerText =
            percent.toFixed(2) + "%";
        row.insertCell(3).innerText = grade;
        row.insertCell(4).innerText = result;
    });

    let topTotal = topper.maths +
                   topper.science + topper.english;
    let topPercent = topTotal / 3;
    let average = totalPercent / students.length;

    document.getElementById("summary").innerHTML =
        "<p>Topper: " + topper.name +
        " (" + topPercent.toFixed(2) + "%)</p>" +
        "<p>Class average: " +
        average.toFixed(2) + "%</p>" +
        "<p>Passed: " + passed +
        " of " + students.length + " students</p>";
}
</script>
</body>
</html>